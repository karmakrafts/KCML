<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- Icon providers -->
        <fileIconProvider implementation="dev.karmakrafts.kcml.intellij.icon.PluginConfigIconProvider"/>
        <iconProvider implementation="dev.karmakrafts.kcml.intellij.icon.CompileTargetIconProvider" order="first"/>

        <!-- Local inspections -->
        <localInspection language="kotlin" shortName="KcmlPluginDeclaration"
                         displayName="KCML plugin annotation and interface mismatch"
                         groupName="KCML" enabledByDefault="true" level="WARNING"
                         implementationClass="dev.karmakrafts.kcml.intellij.inspection.PluginDeclarationInspection"/>
        <localInspection language="kotlin" shortName="KcmlPluginInstantiation"
                         displayName="KCML plugin instantiation"
                         groupName="KCML" enabledByDefault="true" level="WARNING"
                         implementationClass="dev.karmakrafts.kcml.intellij.inspection.PluginInstantiationInspection"/>
        <localInspection language="kotlin" shortName="KcmlMixinInstantiation"
                         displayName="KCML mixin instantiation"
                         groupName="KCML" enabledByDefault="true" level="WARNING"
                         implementationClass="dev.karmakrafts.kcml.intellij.inspection.MixinInstantiationInspection"/>
        <localInspection language="kotlin" shortName="KcmlMixinThisAwareImplementation"
                         displayName="KCML mixin ThisAware implementation"
                         groupName="KCML" enabledByDefault="true" level="WARNING"
                         implementationClass="dev.karmakrafts.kcml.intellij.inspection.MixinThisAwareImplementationInspection"/>
        <localInspection language="kotlin" shortName="KcmlOnlyInsideMixinUsage"
                         displayName="KCML mixin-only API usage"
                         groupName="KCML" enabledByDefault="true" level="WARNING"
                         implementationClass="dev.karmakrafts.kcml.intellij.inspection.OnlyInsideMixinUsageInspection"/>

        <!-- Implicit usage providers -->
        <implicitUsageProvider implementation="dev.karmakrafts.kcml.intellij.gutter.PluginImplicitUsageProvider"/>
        <implicitUsageProvider implementation="dev.karmakrafts.kcml.intellij.gutter.MixinImplicitUsageProvider"/>
        <implicitUsageProvider implementation="dev.karmakrafts.kcml.intellij.gutter.InjectImplicitUsageProvider"/>

        <!-- Line marker providers -->
        <codeInsight.lineMarkerProvider language="kotlin"
                                        implementationClass="dev.karmakrafts.kcml.intellij.gutter.MixinLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="kotlin"
                                        implementationClass="dev.karmakrafts.kcml.intellij.gutter.PluginLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="kotlin"
                                        implementationClass="dev.karmakrafts.kcml.intellij.gutter.InjectLineMarkerProvider"/>

        <!-- Completion contributors -->
        <completion.contributor language="kotlin" order="first"
                                implementationClass="dev.karmakrafts.kcml.intellij.completion.CompileTargetCompletionContributor"/>
        <completion.contributor language="kotlin" order="first"
                                implementationClass="dev.karmakrafts.kcml.intellij.completion.IndirectMixinCompletionContributor"/>
        <typedHandler implementation="dev.karmakrafts.kcml.intellij.completion.IndirectMixinCompletionTypedHandler"
                      order="first"/>
        <completion.confidence language="kotlin" order="first"
                               implementationClass="dev.karmakrafts.kcml.intellij.completion.IndirectMixinCompletionConfidence"/>
        <completion.contributor language="kotlin" order="first"
                                implementationClass="dev.karmakrafts.kcml.intellij.completion.InjectCompletionContributor"/>
        <typedHandler implementation="dev.karmakrafts.kcml.intellij.completion.InjectCompletionTypedHandler"
                      order="first"/>
        <completion.confidence language="kotlin" order="first"
                               implementationClass="dev.karmakrafts.kcml.intellij.completion.InjectCompletionConfidence"/>
        <completion.contributor language="kotlin" order="first"
                                implementationClass="dev.karmakrafts.kcml.intellij.completion.PluginIdCompletionContributor"/>
        <completion.contributor language="JSON" order="first"
                                implementationClass="dev.karmakrafts.kcml.intellij.completion.PluginIdCompletionContributor"/>
        <typedHandler implementation="dev.karmakrafts.kcml.intellij.completion.PluginIdCompletionTypedHandler"
                      order="first"/>
        <completion.confidence language="kotlin" order="first"
                               implementationClass="dev.karmakrafts.kcml.intellij.completion.PluginIdCompletionConfidence"/>
        <completion.confidence language="JSON" order="first"
                               implementationClass="dev.karmakrafts.kcml.intellij.completion.PluginIdCompletionConfidence"/>
    </extensions>
</idea-plugin>