<idea-plugin>
    <id>dev.karmakrafts.kcml</id>
    <name>KCML</name>
    <vendor email="support@karmakrafts.dev" url="https://karmakrafts.dev">Karma Krafts</vendor>

    <description>
        <![CDATA[
        IDE integration for KCML features like mixins and plugin configs.
        ]]>
    </description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>
    <depends optional="true" config-file="dependencies/java.xml">com.intellij.java</depends>
    <depends optional="true" config-file="dependencies/kotlin.xml">org.jetbrains.kotlin</depends>
    <idea-version since-build="223"/>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>
</idea-plugin>